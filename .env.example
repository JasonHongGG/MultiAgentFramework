# Example Agent Configuration
# Defines which provider to use for the 'example' agent
AGENT_EXAMPLE_PROVIDER=ollama
# The model the provider should use
AGENT_EXAMPLE_MODEL=llama3.1

# Provider Configurations

# --- Ollama ---
PROVIDER_OLLAMA_URL=http://localhost:11434

# --- Vertex AI ---
PROVIDER_VERTEX_PROJECT_ID=your-gcp-project-id
PROVIDER_VERTEX_REGION=us-central1
PROVIDER_VERTEX_ACCESS_TOKEN=your-gcloud-access-token

# --- GeminiFlow ---
PROVIDER_GEMINIFLOW_URL=http://127.0.0.1:8000
