# ==============================================================================
# Agent Configurations
# ==============================================================================
# Configure the AI Provider and Model for each specific agent in the system.

# [ExampleAgent]
# Available Providers: 'ollama', 'vertex', 'geminiflow'
AGENT_EXAMPLE_PROVIDER=ollama
# Recommended Models: 
# - for ollama: 'llama3.1', 'mistral', 'gemma2'
# - for vertex: 'gemini-1.5-pro', 'gemini-1.5-flash'
# - for geminiflow: 'gemini-3-pro'
AGENT_EXAMPLE_MODEL=llama3.1


# ==============================================================================
# 🔌 Provider Configurations
# ==============================================================================
# Connection details and credentials for each supported AI Provider backend.

# --- Ollama ---
PROVIDER_OLLAMA_URL=http://localhost:11434

# --- Vertex AI ---
PROVIDER_VERTEX_PROJECT_ID=your-gcp-project-id
# Available Regions: 'us-central1', 'asia-east1', 'global', etc.
PROVIDER_VERTEX_REGION=us-central1
PROVIDER_VERTEX_ACCESS_TOKEN=your-gcloud-access-token

# --- GeminiFlow ---
PROVIDER_GEMINIFLOW_URL=http://127.0.0.1:8000
